# Server
PORT=3000
NODE_ENV=development

# Database — set the REAL value only in Render's environment settings,
# never here. This file is committed to a public repo.
DATABASE_URL=postgresql://user:password@host:5432/dbname?ssl=true

# Auth — required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the REAL value only in Render's environment settings.
JWT_SECRET=

# Optional: bootstrap the first admin account on first boot with a chosen
# username/password instead of an auto-generated one-time password.
# Set these only in Render's environment, never here, and unset them again
# after the first successful boot.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Daraja (M-Pesa) - sandbox values from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://your-domain.com/webhooks/daraja

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
